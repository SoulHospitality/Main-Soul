# =============================================================================
# Main Soul — environment template (safe to commit)
# Copy to Server/.env for local use. Production: set these in Railway only.
# Domain: https://soulhospitality.co
# =============================================================================

NODE_ENV=development
PORT=5000

# Required: Supabase Postgres connection URI (Session pooler :5432)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# App JWT — REQUIRED in production: long random string (32+ chars). Server refuses to boot without it when NODE_ENV=production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Optional Supabase Auth API (leave blank for local guest JWT)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=

# Local URLs
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173/admin
CORS_ORIGIN=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:5000

# Production (Railway) example:
# NODE_ENV=production
# FRONTEND_URL=https://soulhospitality.co
# ADMIN_URL=https://soulhospitality.co/admin
# CORS_ORIGIN=https://soulhospitality.co,https://www.soulhospitality.co
# BACKEND_PUBLIC_URL=https://soulhospitality.co

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paymob (optional — enable when payments go live)
# PAYMOB_API_KEY=
# PAYMOB_INTEGRATION_ID=
# PAYMOB_IFRAME_ID=
# PAYMOB_HMAC_SECRET=
# PAYMOB_BASE_URL=https://accept.paymob.com/api

RESEND_API_KEY=
INQUIRY_TO_EMAIL=info@soulhospitality.co
INQUIRY_FROM_EMAIL=Soul Hospitality <info@soulhospitality.co>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# WhatsApp Cloud API (Meta) — see Server/docs/whatsapp-meta-setup.md
# Leave blank to disable sends. Requires approved templates before live guest messages.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_TEMPLATE_LANG=en
# WHATSAPP_TEMPLATE_BOOKING_ACCEPTED=booking_accepted
# WHATSAPP_TEMPLATE_CHECKOUT_FEEDBACK=checkout_feedback

# Required for /api/cron/* endpoints (Bearer token). Leave empty only in local if unused — production MUST set a strong secret.
CRON_SECRET=
# Optional shared secret for non-admin pricing sync (admins can sync without it)
PRICING_SYNC_SECRET=

# Initial admin is created only when no admin exists. Never overwrites existing passwords.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@soulhospitality.co
